# ids-app Development Environment
# Copy this file to .env and adjust as needed
# NEVER commit .env to version control

IDS_ENV=development

# ids-core
IDS_CORE_HOST=127.0.0.1
IDS_CORE_PORT=8088
IDS_STORAGE_MODE=memory
DATABASE_URL=postgres://ids_user:ids_dev_password@127.0.0.1:5433/ids_dev?sslmode=disable

# analytics-api
ANALYTICS_API_HOST=127.0.0.1
ANALYTICS_API_PORT=8090

# mcp-server
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8091
IDS_CORE_BASE_URL=http://127.0.0.1:8088
IDS_ANALYTICS_BASE_URL=http://127.0.0.1:8090
IDS_MCP_MODE=read_only
IDS_MCP_TIMEOUT_SECONDS=5

# PostgreSQL (development only)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=ids_dev
POSTGRES_USER=ids_user
POSTGRES_PASSWORD=ids_dev_password

# Redis (development only)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
