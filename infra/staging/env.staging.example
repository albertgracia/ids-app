# ids-app Staging Environment
# Copy to .env and fill with real values
# NEVER commit .env to version control

IDS_ENV=staging

IDS_WEB_PORT=3002
IDS_CORE_PORT=8088
IDS_ANALYTICS_PORT=8090
IDS_MCP_PORT=8091

POSTGRES_DB=ids_staging
POSTGRES_USER=ids_user
# Generate a strong password:
POSTGRES_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME

IDS_CORE_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@ids-postgres:5432/${POSTGRES_DB}?sslmode=disable
IDS_REDIS_URL=redis://:${REDIS_PASSWORD}@ids-redis:6379/0

NEXT_PUBLIC_IDS_CORE_URL=http://192.168.1.40:${IDS_CORE_PORT:-8088}
NEXT_PUBLIC_ANALYTICS_API_URL=http://192.168.1.40:${IDS_ANALYTICS_PORT:-8090}
